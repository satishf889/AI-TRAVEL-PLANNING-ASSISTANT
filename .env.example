# ─────────────────────────────────────────────
# Azure OpenAI LLM
# ─────────────────────────────────────────────
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-5-mini

# ─────────────────────────────────────────────
# LLM Settings
# ─────────────────────────────────────────────
AZURE_OPENAI_TEMPERATURE=0.3
AZURE_OPENAI_MAX_TOKENS=4096

# ─────────────────────────────────────────────
# Embedding Model (Azure OpenAI)
# ─────────────────────────────────────────────
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
EMBEDDING_API_VERSION=2024-02-01

# ─────────────────────────────────────────────
# Vector Store (ChromaDB)
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=singapore_travel

# ─────────────────────────────────────────────
# RAG Settings
# ─────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# ─────────────────────────────────────────────
# MCP Tool: Weather (Open-Meteo — no key needed)
# ─────────────────────────────────────────────
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
DESTINATION_LATITUDE=1.3521
DESTINATION_LONGITUDE=103.8198
DESTINATION_CITY=Singapore

# ─────────────────────────────────────────────
# MCP Tool: Currency (Frankfurter — no key needed)
# ─────────────────────────────────────────────
CURRENCY_API_BASE_URL=https://api.frankfurter.app

# ─────────────────────────────────────────────
# Knowledge Base
# ─────────────────────────────────────────────
KNOWLEDGE_BASE_DIRECTORY=./knowledge_base

# ─────────────────────────────────────────────
# Cache Settings (Redis & In-Memory)
# ─────────────────────────────────────────────
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_TTL_SECONDS=3600

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_TITLE=AI Travel Planning Assistant
APP_DESTINATION=Singapore
LOG_LEVEL=INFO

