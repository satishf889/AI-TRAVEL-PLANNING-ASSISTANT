# ─────────────────────────────────────────────
# Google Gemini Pro LLM
# ─────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here

# ─────────────────────────────────────────────
# LLM Settings
# ─────────────────────────────────────────────
GEMINI_MODEL_NAME=gemini-1.5-pro
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=4096

# ─────────────────────────────────────────────
# Embedding Model (local HuggingFace — no key needed)
# ─────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# ─────────────────────────────────────────────
# Vector Store (ChromaDB)
# ─────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=singapore_travel

# ─────────────────────────────────────────────
# RAG Settings
# ─────────────────────────────────────────────
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# ─────────────────────────────────────────────
# MCP Tool: Weather (Open-Meteo — no key needed)
# ─────────────────────────────────────────────
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1
WEATHER_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1
DESTINATION_LATITUDE=1.3521
DESTINATION_LONGITUDE=103.8198
DESTINATION_CITY=Singapore

# ─────────────────────────────────────────────
# MCP Tool: Currency (Frankfurter — no key needed)
# ─────────────────────────────────────────────
CURRENCY_API_BASE_URL=https://api.frankfurter.app

# ─────────────────────────────────────────────
# Knowledge Base
# ─────────────────────────────────────────────
KNOWLEDGE_BASE_DIRECTORY=./knowledge_base

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_TITLE=AI Travel Planning Assistant
APP_DESTINATION=Singapore
LOG_LEVEL=INFO
